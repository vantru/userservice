pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'userservice', description: 'Name of the Docker image')
        string(name: 'CONTEXT', defaultValue: '.', description: 'Docker build context')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS Default Region')
        string(name: 'FLOCI_ENDPOINT', defaultValue: 'http://localhost:4566', description: 'Local AWS/Floci Endpoint')
        string(name: 'ECR_REGISTRY', defaultValue: '000000000000.dkr.ecr.us-east-1.localhost:5100', description: 'Target Registry')
    }

    environment {
        // Lấy secret token an toàn từ Jenkins Credentials (Dạng Secret Text với ID: gh-packages-token)
        GH_TOKEN = credentials('gh-packages-token')
        
        // Tự động cắt chuỗi lấy 7 ký tự đầu của Git Commit Hash ngắn gọn
        SHORT_SHA = "${GIT_COMMIT[0..6]}" 
        
        // Biến môi trường giả lập AWS dùng cho AWS CLI công cụ
        AWS_ENDPOINT_URL = "${params.FLOCI_ENDPOINT}"
        AWS_ACCESS_KEY_ID = "test"
        AWS_SECRET_ACCESS_KEY = "test"
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Settings & ECR') {
            steps {
                sh '''
                    envsubst < .github/ci/settings.xml.template > settings.xml
                    
                    aws ecr create-repository \
                        --repository-name "${params.IMAGE_NAME}" \
                        --endpoint-url "$AWS_ENDPOINT_URL" || true
                '''
            }
        }

        stage('Docker Login & Build') {
            steps {
                sh '''
                    aws ecr get-login-password --endpoint-url "$AWS_ENDPOINT_URL" \
                        | docker login --username AWS --password-stdin "${params.ECR_REGISTRY}"
                    
                    # Kích hoạt tính năng Docker BuildKit
                    export DOCKER_BUILDKIT=1
                    
                    # Thực hiện Build Docker và truyền tệp settings.xml qua tham số --secret
                    # Đồng thời tối ưu bộ nhớ đệm cache inline cho Maven Dependencies
                    docker build \
                        --build-arg BUILDKIT_INLINE_CACHE=1 \
                        --cache-from "${params.ECR_REGISTRY}/${params.IMAGE_NAME}:latest" \
                        --secret id=maven_settings,src=settings.xml \
                        -t "${params.ECR_REGISTRY}/${params.IMAGE_NAME}:${SHORT_SHA}" \
                        -t "${params.ECR_REGISTRY}/${params.IMAGE_NAME}:latest" \
                        "${params.CONTEXT}"
                        
                    # Đẩy cả phiên bản gắn nhãn SHA cụ thể và phiên bản 'latest' lên ECR Registry
                    docker push "${params.ECR_REGISTRY}/${params.IMAGE_NAME}:${SHORT_SHA}"
                    docker push "${params.ECR_REGISTRY}/${params.IMAGE_NAME}:latest"
                '''
            }
        }

        stage('Update Kubernetes Manifest') {
            when {
                // Chỉ áp dụng khi code được merge/push trực tiếp vào nhánh chính (main)
                branch 'main'
            }
            steps {
                sh '''
                    FILE="./k8s/userservice-pod.yml"
                    
                    # Cập nhật thông tin định danh thẻ Image Tag bằng yq
                    yq -i '(select(.kind == "Deployment") | .spec.template.spec.containers.image) = "'"${params.ECR_REGISTRY}/${params.IMAGE_NAME}:${SHORT_SHA}"'"' "$FILE"
                    
                    # Đồng bộ định danh cục bộ để thực hiện commit ngược về kho lưu trữ
                    git config user.email "vantruit@gmail.com"
                    git config user.name "vantru"
                    git add k8s/userservice-pod.yml
                    git commit -m "change tag sha [skip ci]" || echo "No changes to commit"
                    
                    # Đẩy code an toàn lên nhánh main
                    git push origin HEAD:main
                '''
            }
        }
    }

    post {
        always {
            // Sửa lỗi MissingContextVariableException: Ép buộc chạy lệnh xóa trong ngữ cảnh nút tính toán (node)
            node {
                sh 'rm -f settings.xml'
            }
        }
    }
}
